<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <property name="LOG_FILE" value="${user.home}/.algolab.log"/>

    <!-- File only: all application + Spring logs go here. No console appender. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${user.home}/.algolab.log.%d{yyyy-MM-dd}.%i.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- All Spring/framework noise goes to the log file, not the terminal -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.apache.catalina" level="INFO"/>
    <logger name="org.apache.coyote" level="INFO"/>
    <logger name="org.apache.jasper" level="INFO"/>
    <logger name="org.hibernate" level="INFO"/>
    <logger name="jdk.event.security" level="INFO"/>
    <logger name="ch.qos.logback" level="WARN"/>
    <logger name="org.apache.tomcat" level="INFO"/>
    <logger name="org.springframework.boot" level="INFO"/>

    <!-- DSA Playground: TRACE-level detail for every internal operation -->
    <logger name="com.dsaplayground" level="TRACE"/>

    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>

</configuration>
