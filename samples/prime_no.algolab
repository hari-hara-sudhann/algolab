  "code": "import java.util.*;\n\npublic class Main {\n\tpublic static void main(String[] args) {\n\t\tScanner input = new Scanner(System.in);\n        Add add = (a, b) -> a + b;\n        add.add(2, 3);\n        int n = input.nextInt();\n\n        for (int i = 2; i <= n/2; i++) {\n            if (n%i != 0) continue;\n            System.out.println(\"Not Prime\");\n            return;\n        }\n\n        System.out.println(\"Prime\");\n\t}\n}\n\n@FunctionalInterface\ninterface Add {\n    int add(int a, int b);\n}\n",
