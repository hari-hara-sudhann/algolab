# ==============================================================================
# AlgoLab / DSA Playground — environment configuration template
# ==============================================================================
# Copy this file to `.env` (cp .env.example .env) and fill in your values.
# `.env` is gitignored — real credentials belong there, never here.
#
# The app reads this file at startup (real exported environment variables
# always win). Leave a variable blank to use its built-in default.
#
# Formatting rules:
#   - One VARIABLE=value per line (no spaces around '=').
#   - Lines starting with '#' are ignored (comments).
#   - Blank lines are ignored.
#   - Values containing spaces should be quoted, e.g. SERVER_PORT="8080".
# ==============================================================================

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------

# HTTP port the embedded Tomcat listens on.
# Supported values: any free port number (1024-65535 recommended).
# Default: 8080.
SERVER_PORT=8080

# Base directory for the workspace (file browser, notebook storage, etc.).
# Supported values: an absolute path, or a bare name resolved relative to the
#   process working directory at startup.
# Default: the directory from which the JVM was launched (user.dir).
DSA_ROOT=

# ------------------------------------------------------------------------------
# JDK / runtime
# ------------------------------------------------------------------------------

# JAVA_HOME used for JDK discovery. If unset, the JVM's own java.home and PATH
# are probed for additional installations.
# Supported values: absolute path to a JDK home directory (the dir containing
#   bin/java and bin/javac). Windows paths may use either '\' or '/'.
# Default: (unset) — discovery probes JAVA_HOME, java.home, macOS java_home,
#   Linux /usr/lib/jvm / SDKMAN, Windows ProgramFiles\Java, and PATH.
JAVA_HOME=

# ------------------------------------------------------------------------------
# Judge0 remote execution (fallback when no local JDK is found)
# ------------------------------------------------------------------------------
# AlgoLab runs Java with a local JDK whenever one is available. Only when no
# usable JDK exists on this machine does it fall back to the Judge0 API, so
# users without a JDK can still practice. Leave a variable blank to use its
# default.

# Base URL of the Judge0 API used for the remote-execution fallback.
# Supported values: an http(s) URL, e.g. https://ce.judge0.com (public CE,
#   no key needed) or http://localhost:2358 (self-hosted Docker image).
# Default: https://ce.judge0.com
JUDGE0_API_URL=

# Credential sent when the Judge0 service requires one (self-hosted instances
# with authentication enabled, RapidAPI hosts, ...). Blank = no auth header.
# NEVER commit a real key — this is exactly why .env is gitignored.
# Default: unset (no credential).
JUDGE0_API_KEY=

# Name of the header JUDGE0_API_KEY is sent as.
# Default: X-Auth-Token (self-hosted Judge0). Use X-RapidAPI-Key for the
#   RapidAPI-hosted Judge0, where the key is issued by RapidAPI.
JUDGE0_AUTH_HEADER=

# Judge0 language id used for Java submissions.
# Supported values: any integer language id present on your Judge0 instance
#   (GET /languages lists them). 91 = Java (JDK 17) on current CE images;
#   62 = Java (OpenJDK 13) on older images.
# Default: 91.
JUDGE0_JAVA_LANGUAGE_ID=

# ------------------------------------------------------------------------------
# Colors / terminal UI
# ------------------------------------------------------------------------------

# When "1" (or any truthy value), force ANSI color output even when stdout is
# not a TTY.
# Default: empty (TTY auto-detection decides).
ALGOLAB_FORCE_COLORS=1

# Standard "no color" opt-out. When set to any value, ANSI colors and
# cursor-control sequences are suppressed entirely.
# Default: unset.
NO_COLOR=

# ------------------------------------------------------------------------------
# User settings file location
# ------------------------------------------------------------------------------

# Override the path where the frontend settings JSON is persisted
# (~/.algolab-settings by default). The file is written atomically.
# Supported values: absolute path to a regular file, or unset.
# Default: $HOME/.algolab-settings (or %USERPROFILE%\.algolab-settings on Windows).
ALGOLAB_SETTINGS=